+    -DCMAKE_CXX_COMPILER_ARG1="$(wordlist 2,99,$(host_CXX))" \
+    -DCMAKE_PREFIX_PATH=$(host_prefix) \
+    -DOPENSSL_ROOT_DIR="$(host_prefix)" \
