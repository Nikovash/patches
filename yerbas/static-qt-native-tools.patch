diff --git a/depends/packages/native_bison.mk b/depends/packages/native_bison.mk
new file mode 100644
index 0000000000000000000000000000000000000000..ad5616e68fcf4ded4ed1354ef49e19f817b32457
--- /dev/null
+++ b/depends/packages/native_bison.mk
@@ -0,0 +1,17 @@
+package=native_bison
+$(package)_version=3.8.2
+$(package)_download_path=https://ftp.gnu.org/gnu/bison
+$(package)_file_name=bison-$($(package)_version).tar.xz
+$(package)_sha256_hash=9bba0214ccf7f1079c5d59210045227bcf619519840ebfa80cd3849cff5a5bf2
+
+define $(package)_config_cmds
+  $($(package)_autoconf) --disable-nls
+endef
+
+define $(package)_build_cmds
+  $(MAKE)
+endef
+
+define $(package)_stage_cmds
+  $(MAKE) DESTDIR=$($(package)_staging_dir) install
+endef
diff --git a/depends/packages/native_meson.mk b/depends/packages/native_meson.mk
new file mode 100644
index 0000000000000000000000000000000000000000..ea108faf92eab5306874042d90c71585bed0982b
--- /dev/null
+++ b/depends/packages/native_meson.mk
@@ -0,0 +1,11 @@
+package=native_meson
+$(package)_version=1.7.0
+$(package)_download_path=https://github.com/mesonbuild/meson/releases/download/$($(package)_version)
+$(package)_file_name=meson-$($(package)_version).tar.gz
+$(package)_sha256_hash=08efbe84803eed07f863b05092d653a9d348f7038761d900412fddf56deb0284
+
+define $(package)_stage_cmds
+  mkdir -p $($(package)_staging_prefix_dir)/bin $($(package)_staging_prefix_dir)/share/meson && \
+  cp -R meson.py mesonbuild COPYING $($(package)_staging_prefix_dir)/share/meson/ && \
+  ln -s ../share/meson/meson.py $($(package)_staging_prefix_dir)/bin/meson
+endef
diff --git a/depends/packages/native_ninja.mk b/depends/packages/native_ninja.mk
new file mode 100644
index 0000000000000000000000000000000000000000..cb1cc566b8e27dc1d46281281174cdf1bc3adabf
--- /dev/null
+++ b/depends/packages/native_ninja.mk
@@ -0,0 +1,15 @@
+package=native_ninja
+$(package)_version=1.12.1
+$(package)_download_path=https://codeload.github.com/ninja-build/ninja/tar.gz/refs/tags
+$(package)_download_file=v$($(package)_version)
+$(package)_file_name=ninja-$($(package)_version).tar.gz
+$(package)_sha256_hash=821bdff48a3f683bc4bb3b6f0b5fe7b2d647cf65d52aeb63328c91a6c6df285a
+
+define $(package)_build_cmds
+  CXX="$(build_CXX)" python3 configure.py --bootstrap
+endef
+
+define $(package)_stage_cmds
+  mkdir -p $($(package)_staging_prefix_dir)/bin && \
+  cp ninja $($(package)_staging_prefix_dir)/bin/
+endef
